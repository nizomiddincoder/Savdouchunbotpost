# Server manzili (Railway domeni, wss bilan!)
SERVER_URL=wss://sizning-app.up.railway.app

# Serverdagi AGENT_TOKEN bilan BIR XIL bo'lishi shart
AGENT_TOKEN=uzin-tasodifiy-uzun-token

# 1-variant (tavsiya): printer tarmoqda (IP orqali, port 9100)
PRINTER_MODE=network
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# 2-variant: printer Windows ulashi orqali
# PRINTER_MODE=windows
# PRINTER_SHARE=\\KOMPYUTER-NOMI\PRINTER-NOMI

# 3-variant: sinov uchun (chek konsolga chiqadi, chop etilmaydi)
# PRINTER_MODE=console

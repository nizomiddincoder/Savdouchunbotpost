# Server manzili (Railway domeni, wss bilan — oldida "https://" yozilmaydi!)
SERVER_URL=wss://savdouchunbotpost-production.up.railway.app

# Serverdagi AGENT_TOKEN bilan BIR XIL bo'lishi shart
AGENT_TOKEN=jhqv43v3vrfjqhechqb34ih43b2h3b4gjhfbqr3hb1

# USB XPrinter (Windows'da oddiy printer sifatida o'rnatilgan)
PRINTER_MODE=windows
# Printers & scanners dagi ANIQ nomini yozing — nom bir harfdan farq qilsa ham ishlamaydi.
PRINTER_NAME=POSPrinter POS-80C

# Eslatma: printer nomini admin panel > Sozlamalar > "Windows printer nomi"
# maydonidan ham berish mumkin — server uni agentga config xabari bilan yuboradi.

# Chop etish navbati (ixtiyoriy sozlamalar)
# Har chek ketma-ket yuboriladi, xato bo'lsa ~2 daqiqa davomida qayta uriniladi,
# chop etilmagan chek print-agent/queue/ papkasida saqlanadi va agent qayta
# ishga tushganda yuboriladi. Muammoni tekshirish uchun log: print-agent/agent.log
# PRINTER_NO_QUEUE_CLEAN=1  -> spooler'dagi tiqilib qolgan ishlarni avtomatik o'chirishni taqiqlash
# Eski rejimlar (kerak bo'lsa):
# PRINTER_MODE=network   -> PRINTER_HOST=192.168.1.50, PRINTER_PORT=9100
# PRINTER_MODE=share     -> PRINTER_SHARE=\\windows\POSPrinter POS-80C
# PRINTER_MODE=console   -> sinov (chek faqat konsolga chiqadi)

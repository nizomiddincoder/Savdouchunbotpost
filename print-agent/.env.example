# Server manzili (Railway domeni, wss bilan!)
SERVER_URL=wss://sizning-app.up.railway.app

# Serverdagi AGENT_TOKEN bilan BIR XIL bo'lishi shart
AGENT_TOKEN=uzin-tasodifiy-uzun-token

# USB XPrinter (Windows'da oddiy printer sifatida o'rnatilgan)
PRINTER_MODE=windows
PRINTER_NAME=YOUR_WINDOWS_PRINTER_NAME

# Eslatma: printer nomini admin panel > Sozlamalar > "Windows printer nomi"
# maydonidan ham berish mumkin — server uni agentga config xabari bilan yuboradi.

# Eski rejimlar (kerak bo'lsa):
# PRINTER_MODE=network   -> PRINTER_HOST=192.168.1.50, PRINTER_PORT=9100
# PRINTER_MODE=share     -> PRINTER_SHARE=\\KOMPYUTER-NOMI\PRINTER-NOMI
# PRINTER_MODE=console   -> sinov (chek faqat konsolga chiqadi)

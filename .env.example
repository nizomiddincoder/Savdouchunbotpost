# Railway PostgreSQL URL (Railway > PostgreSQL > Connect > Database URL)
DATABASE_URL=postgresql://user:parol@host:5432/railway

# Dasturning ochiq URL manzili (Railway domeni)
APP_URL=https://sizning-app.up.railway.app

# Chek agenti ulanish tokeni (o'zingiz tasodifiy uzun so'z yozing)
AGENT_TOKEN=uzin-tasodifiy-uzun-token

# JWT kalit (bo'sh qoldirilsa avtomatik yaratiladi va bazada saqlanadi)
JWT_SECRET=

# Admin login (birinchi kirishdan oldin o'zgartiring!)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Telegram bot tokeni (@BotFather dan)
BOT_TOKEN=

# Savdo xabarlari tushadigan guruh ID (bot guruhda admin bo'lishi kerak)
GROUP_CHAT_ID=
